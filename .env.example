# ─── Core ────────────────────────────────────────────────────────────
# Public site URL (no trailing slash). Change when the real domain is live.
NEXT_PUBLIC_SITE_URL="https://royalehotel.ge"
# PostgreSQL connection string (Neon, Supabase, RDS or local)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/royale_hotel"

# ─── Auth (admin panel) ──────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Required when self-hosting behind a proxy (Vercel sets it automatically)
AUTH_TRUST_HOST="true"
# First owner account, created by the seed script
SEED_OWNER_EMAIL="owner@royalehotel.ge"
SEED_OWNER_PASSWORD="change-me-now"

# ─── Email (phase d) ─────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Royale Hotel <booking@royalehotel.ge>"

# ─── Telegram notifications (phase d) ────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Payments (phase d) ──────────────────────────────────────────────
TBC_CLIENT_ID=""
TBC_CLIENT_SECRET=""
TBC_API_KEY=""
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""

# ─── Media storage ───────────────────────────────────────────────────
# "local" writes to ./storage/media (VPS/Docker). Use "blob" on Vercel (Vercel Blob store → token below).
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# ─── Analytics (loaded only after cookie consent) ────────────────────
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ─── Background jobs (expire unpaid bookings, payment re-checks, iCal sync — every 15 min) ───
# Vercel: vercel.json cron calls /api/cron/maintenance with this secret. VPS: set ENABLE_INTERNAL_CRON=true.
CRON_SECRET=""
ENABLE_INTERNAL_CRON="true"
# Mock payment provider is disabled in production unless explicitly allowed (staging only!)
PAYMENTS_ALLOW_MOCK="false"
TBC_API_BASE="https://api.tbcbank.ge"
BOG_AUTH_URL="https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token"
BOG_API_BASE="https://api.bog.ge/payments/v1"

# ─── Tests ───────────────────────────────────────────────────────────
# Separate database for `npm test` (never the real data). Default: postgresql://localhost:5432/royale_hotel_test
TEST_DATABASE_URL=""
# Run Playwright against an already running / deployed app instead of starting `npm run dev`
E2E_BASE_URL=""
